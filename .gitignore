# Raw source data -- restored by data\download_data.ps1
data/raw/*
!data/raw/.gitkeep

# Portable query engine -- restored by run_pipeline.ps1
tools/*
!tools/.gitkeep

# MySQL bulk-load exports (fct_sales alone is ~1M rows / 96 MB) -- regenerate with run_pipeline.ps1
outputs/mysql_load/*
!outputs/mysql_load/.gitkeep

# Local database file -- rebuilt by the pipeline
outputs/*.duckdb
outputs/*.duckdb.wal

# Working files
~$*.xlsx
*.pbix.bak
*.tmp
Thumbs.db
.DS_Store
desktop.ini
